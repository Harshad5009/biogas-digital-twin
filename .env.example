# ============================================================
# BIOGAS DIGITAL TWIN — Environment Configuration Template
# Copy this file to .env and fill in your values.
# ============================================================

# --- Application ---
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret

# --- Database ---
DATABASE_URL=sqlite:///./data/biogas.db

# --- MQTT Broker ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=biogas-backend

# --- MQTT Topics ---
MQTT_TOPIC_SENSORS=biogas/digester01/sensors
MQTT_TOPIC_STATUS=biogas/digester01/status
MQTT_TOPIC_COMMANDS=biogas/digester01/commands
MQTT_TOPIC_SIMULATION=biogas/digester01/simulation
MQTT_TOPIC_ALERTS=biogas/digester01/alerts

# --- Simulation ---
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_SECONDS=5

# --- Digester ---
DIGESTER_ID=digester01

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
